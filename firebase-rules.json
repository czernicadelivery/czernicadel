{
  "_INSTRUKCJA": "Wgraj te reguły do Firebase Console → Realtime Database → Reguły",
  "rules": {
    "admins": {
      "$uid": {
        ".read": "auth !== null && auth.uid === $uid",
        ".write": false
      }
    },
    "zamowienia": {
      ".indexOn": ["uid", "timestamp", "status", "slotDate"],
      "$orderId": {
        ".read": "auth !== null && (root.child('admins').child(auth.uid).exists() || (data.child('uid').val() === auth.uid))",
        ".write": "auth !== null && (!data.exists() || data.child('uid').val() === auth.uid || root.child('admins').child(auth.uid).exists())",
        ".validate": "newData.hasChildren(['id', 'imie', 'adres', 'lista', 'koszt', 'data']) && newData.child('imie').val().length >= 2 && newData.child('imie').val().length <= 100 && newData.child('adres').val().length >= 5 && newData.child('adres').val().length <= 200 && newData.child('lista').val().length >= 0 && newData.child('lista').val().length <= 2000",
        "status": {
          ".write": "auth !== null && root.child('admins').child(auth.uid).exists()",
          ".validate": "newData.val() === 'Przyjeto' || newData.val() === 'W drodze' || newData.val() === 'Dostarczone'"
        },
        "paczkomatTelefon": {
          ".validate": "newData.val().length >= 6 && newData.val().length <= 20"
        },
        "paczkomatKod": {
          ".validate": "newData.val().length >= 6 && newData.val().length <= 9"
        },
        "paczkomatImie": {
          ".validate": "newData.val().length >= 2 && newData.val().length <= 100"
        },
        "paczkomatPobranie": {
          ".validate": "newData.val().length <= 20"
        },
        "platnoscStatus": {
          ".validate": "newData.val().length <= 200"
        },
        "nadanieAdres": {
          ".validate": "newData.val().length >= 5 && newData.val().length <= 200"
        },
        "nadanieTelefon": {
          ".validate": "newData.val().length >= 6 && newData.val().length <= 20"
        },
        "nadanieOpis": {
          ".validate": "newData.val().length <= 500"
        },
        "osoby3AdresOdbioru": {
          ".validate": "newData.val().length >= 5 && newData.val().length <= 200"
        },
        "osoby3KontaktOdbioru": {
          ".validate": "newData.val().length >= 3 && newData.val().length <= 150"
        },
        "osoby3AdresDostawy": {
          ".validate": "newData.val().length >= 5 && newData.val().length <= 200"
        },
        "osoby3KontaktDostawy": {
          ".validate": "newData.val().length >= 3 && newData.val().length <= 150"
        }
      }
    },
    "opinie": {
      ".read": true,
      ".indexOn": ["orderId", "date"],
      "$reviewId": {
        ".write": "auth !== null && (!data.exists() || data.child('uid').val() === auth.uid || root.child('admins').child(auth.uid).exists())",
        ".validate": "newData.hasChildren(['id', 'imie', 'nazwisko', 'tresc', 'orderId', 'prod', 'cena', 'dostawa', 'date']) && newData.child('tresc').val().length >= 10 && newData.child('tresc').val().length <= 1000 && newData.child('prod').val() >= 1 && newData.child('prod').val() <= 5 && newData.child('cena').val() >= 1 && newData.child('cena').val() <= 5 && newData.child('dostawa').val() >= 1 && newData.child('dostawa').val() <= 5",
        "$field": {
          ".write": "auth !== null && root.child('admins').child(auth.uid).exists()"
        }
      }
    },
    "ustawienia": {
      ".read": true,
      ".write": "auth !== null && root.child('admins').child(auth.uid).exists()",
      ".validate": "newData.hasChildren(['isAvailable'])",
      "pickupEnabled": {
        ".validate": true
      },
      "cennik": {
        ".validate": true
      },
      "scheduleMode": {
        ".validate": "newData.val() === 'auto' || newData.val() === 'wakacje' || newData.val() === 'szkola'"
      },
      "szkolaPlan": {
        ".validate": "newData.val() === 'a' || newData.val() === 'b'"
      },
      "disabledHolidays": {
        ".validate": true,
        "$holidayKey": {
          ".validate": "newData.val() === true || newData.val() === null"
        }
      },
      "customHolidays": {
        ".validate": true,
        "$customKey": {
          ".validate": "newData.hasChildren(['name', 'date']) && newData.child('name').val().length >= 1 && newData.child('name').val().length <= 100 && newData.child('date').val().length <= 12"
        }
      },
      "maintenanceReopenAt": {
        ".validate": "newData.val() === null || newData.val().length <= 30"
      },
      "blikNumber": {
        ".validate": "newData.val().length <= 30"
      },
      "bankAccount": {
        ".validate": "newData.val().length <= 40"
      },
      "accountOwner": {
        ".validate": "newData.val().length <= 100"
      },
      "safetyMarginPercent": {
        ".validate": "newData.val() >= 0 && newData.val() <= 100"
      }
    },
    "kody_rabatowe": {
      ".read": true,
      ".write": "auth !== null && root.child('admins').child(auth.uid).exists()",
      "$code": {
        ".validate": "newData.hasChildren(['percent']) && newData.child('percent').val() >= 1 && newData.child('percent').val() <= 99"
      }
    },
    "polecenia": {
      ".read": "auth !== null",
      "$uid": {
        ".read": "auth !== null && (auth.uid === $uid || root.child('admins').child(auth.uid).exists())",
        ".write": "auth !== null && root.child('admins').child(auth.uid).exists()",
        ".validate": "newData.hasChild('count') && newData.child('count').val() >= 0"
      }
    },
    "polecenia_uzycia": {
      ".read": "auth !== null && root.child('admins').child(auth.uid).exists()",
      "$useId": {
        ".write": "!data.exists()",
        ".validate": "newData.hasChildren(['code', 'timestamp']) && newData.child('code').val().length >= 3 && newData.child('code').val().length <= 30"
      }
    },
    "$other": {
      ".read": false,
      ".write": false
    }
  }
}
